---
interface Link {
	url: string;
	icon: string;
}

interface Props {
	title: string;
	img: string;
	description: string;
	isLast?: boolean;
	links?: Link[];
}

const { title, img, description, isLast = false, links = [] } = Astro.props;
---

<div class="flex flex-row space-x-4 pl-4 pt-4 h-fit">
	<img src={img} alt="project image" class="w-12 h-12 object-cover rounded-lg">
	<div class:list={["w-full h-fit pb-4", { "border-b border-white/20": !isLast }]}>
		<div class="flex flex-row items-center space-x-2">
			<a href={links[0]?.url} class="text-lg font-bold text-white hover:text-gray-200 transition-colors">{title}</a>
			{links.map((link) => (
				<a href={link.url} class="text-sm text-gray-300 hover:text-white transition-colors">
					<img src={link.icon} alt="link icon" class="w-4 h-4" />
				</a>
			))}
		</div>
		<p class="text-sm text-gray-300">{description}</p>
	</div>
</div>

