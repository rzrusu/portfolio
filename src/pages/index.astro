---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Project from "../components/Project.astro";
import FreelanceProject from "../components/FreelanceProject.astro";
import ContactCta from "../components/ContactCta.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";
import { projects, profile } from "../data/site";

const work = (await getCollection("work", ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <div class="max-w-3xl mx-auto py-16 md:py-24 px-4 space-y-12">
    <Hero />
    <main class="text-white space-y-8">
      <section class="space-y-4">
        <h2 class="text-2xl font-bold font-instrument">featured work</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {work.map((entry) => <FreelanceProject entry={entry} />)}
        </div>
        <a
          href={profile.behance}
          class="border rounded-lg border-white/20 p-4 flex items-center justify-between text-sm text-gray-300 font-geist hover:text-white transition-all"
        >
          View all my work on Behance
          <Icon name="uil:arrow-right" class="w-4 h-4" />
        </a>
      </section>

      <section class="space-y-4">
        <div class="space-y-1">
          <h2 class="text-2xl font-bold font-instrument">side projects</h2>
          <p class="text-sm text-gray-400 font-geist">Things I've designed and built myself.</p>
        </div>
        <div class="border border-white/20 rounded-lg w-full overflow-hidden">
          {projects.map((p, i) => <Project {...p} isLast={i === projects.length - 1} />)}
        </div>
      </section>

      <ContactCta />

      <Footer />
    </main>
  </div>
</BaseLayout>

