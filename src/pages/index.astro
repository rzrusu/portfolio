---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Project from '../components/Project.astro';
import FreelanceProject from '../components/FreelanceProject.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="flex flex-col lg:flex-row w-full max-w-3xl mx-auto pt-12 lg:pt-24 px-4 lg:px-0 gap-6 lg:gap-4">
		<!-- Left Column - Profile Card -->
		<div class="w-full lg:w-1/3">
			<div class="border border-white/20 rounded-lg relative pt-20 space-y-12">
				<div class="absolute -top-12 left-1/2 transform -translate-x-1/2">
					<Image src="/avatar.png" alt="logo" width={96} height={96} loading="eager" class="w-24 h-24 rounded-full" />
				</div>

				<div class="text-white text-center space-y-2">
					<h1 class="text-2xl font-bold">Rusu Răzvan</h1>
					<p class="text-sm text-[#CCCCCC]">Web Dev & Designer</p>
				</div>

				<div class="grid grid-cols-4 border-t border-white/20">
					<a href="https://github.com/rzrusu" class="w-full h-16 border-r border-white/20 hover:bg-white/10 transition-all duration-300 flex items-center justify-center">
						<img src="/icons/github.svg" alt="icon" loading="eager" class="w-8 h-8">
					</a>
					<a href="https://linkedin.com/in/rusu-razvan" class="w-full h-16 border-r border-white/20 hover:bg-white/10 transition-all duration-300 flex items-center justify-center">
						<img src="/icons/linkedin.svg" alt="icon" loading="eager" class="w-8 h-8">
					</a>
					<a href="mailto:rzrusu03@gmail.com" class="w-full h-16 border-r border-white/20 hover:bg-white/10 transition-all duration-300 flex items-center justify-center">
						<img src="/icons/email.svg" alt="icon" loading="eager" class="w-8 h-8">
					</a>
					<div class="tooltip-container w-full h-16 hover:bg-white/10 transition-all duration-300 flex items-center justify-center">
						<a href="https://discord.com" class="relative">
							<img src="/icons/discord.svg" alt="icon" loading="eager" class="w-8 h-8">
							<span class="tooltip">rusuu</span>
						</a>
					</div>
				</div>
			</div>

			<div class="border rounded-lg border-white/20 p-4 flex items-center justify-between mt-4">
				<a class="text-sm text-gray-300 hover:text-white transition-all" href="https://www.behance.net/rzrusu">View my CV</a>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M5 12h14M12 5l7 7-7 7"/>
				</svg>
			</div>
		</div>

		<!-- Right Column -->
		<div class="w-full lg:w-2/3 text-white space-y-8">
			<!-- Featured Projects -->
			<div class="space-y-4">
				<h1 class="text-2xl font-bold">featured projects</h1>
				<div class="border border-white/20 rounded-lg w-full">
					<Project 
						title="My Football Career" 
						img="/logos/mfc-logo.png"
						description="Mobile football career simulation game, in development" 
						slug="my-football-career"
						isLast={false} 
						loading="eager"
						links={[{ icon: "/icons/link.svg", url: "https://footballcareer.app" }]} 
					/>
					<Project 
						title="gitreleasenotes.io" 
						img="/logos/grn-logo.png"
						description="Generate release notes from GitHub commit history" 
						isLast={true} 
						loading="eager"
						links={[{ icon: "/icons/link.svg", url: "https://gitreleasenotes.com" }]} 
					/>
				</div>
			</div>

			<!-- Featured Freelance Work -->
			<div class="space-y-4">
				<h1 class="text-2xl font-bold">featured freelance work</h1>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<FreelanceProject title="Sparked Host" img="/sparked.webp" description="Website Design" link="https://sparkedhost.com" slug="sparked-host" loading="eager" />
					<FreelanceProject title="EasyMinecraftHosting" img="/emh.webp" description="Website Design" link="https://easyminecrafthosting.com" loading="eager" />
					<FreelanceProject title="Modern Hosting" img="/modern.webp" description="Website Design" link="https://modernhosting.com" loading="eager" />
					<FreelanceProject title="Data Wagon" img="/datawagon.webp" description="Website Design" link="https://datawagon.com" loading="eager" />
				</div>
				<div class="border rounded-lg border-white/20 p-4 flex items-center justify-between">
					<a class="text-sm text-gray-300 hover:text-white transition-all" href="https://www.behance.net/rzrusu">View all my work on Behance</a>
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M5 12h14M12 5l7 7-7 7"/>
					</svg>
				</div>
			</div>

			<!-- Connect With Me -->
			<div class="space-y-4">
				<h1 class="text-2xl font-bold">connect with me</h1>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<a href="https://open.spotify.com/user/iwkw0teuznz322vtae4pulfnc" target="_blank" class="border rounded-lg border-white/20 p-4 flex items-center justify-between hover:border-green-500 hover:bg-green-500/10 transition-all">
						<span class="text-sm text-gray-300 hover:text-white transition-all flex items-center gap-3">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-500" viewBox="0 0 24 24" fill="currentColor">
								<path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
							</svg>
							see what I'm listening to
						</span>
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
						</svg>
					</a>
					<div class="border rounded-lg border-white/20 p-4 flex items-center justify-between hover:border-indigo-500 hover:bg-indigo-500/10 transition-all">
						<div class="tooltip-container">
							<div class="text-sm text-gray-300 hover:text-white transition-all flex items-center gap-3 relative cursor-pointer">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-indigo-500" viewBox="0 0 24 24" fill="currentColor">
									<path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
								</svg>
								let's chat
								<span class="tooltip">rusuu</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Other Projects -->
			<div class="space-y-4">
				<h1 class="text-2xl font-bold">other projects</h1>
				<div class="border border-white/20 rounded-lg w-full">
					<Project 
						title="Sound Bubbles" 
						img="/logos/sb-logo.png" 
						description="Visualize artist albums in an interactive way" 
						isLast={false} 
						loading="lazy"
						links={[{ icon: "/icons/github.svg", url: "https://github.com/rzrusu/songbubbles" }]} 
					/>
					<Project 
						title="Singleplayer Roleplay UCP" 
						img="/logos/sprp-logo.png" 
						description="Multiplayer game user control panel" 
						isLast={true} 
						loading="lazy"
						links={[{ icon: "/icons/github.svg", url: "https://github.com/rzrusu/SPRP-UCP" }]} 
					/>
				</div>
			</div>

			<!-- Footer -->
			<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
				<p class="text-sm text-gray-400">This portfolio is open source. <a href="https://github.com/rzrusu/portfolio" class="text-blue-500 hover:text-blue-600 transition-all">View the source code</a></p>
				<p class="text-sm text-gray-400">© <a href="https://github.com/rzrusu" class="underline">rzrusu</a> 2025</p>
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	.tooltip-container {
		position: relative;
	}

	.tooltip {
		visibility: hidden;
		position: absolute;
		bottom: -30px;
		left: 50%;
		transform: translateX(-50%);
		background-color: rgba(0, 0, 0, 0.8);
		color: white;
		text-align: center;
		border-radius: 6px;
		padding: 4px 8px;
		font-size: 12px;
		white-space: nowrap;
		opacity: 0;
		transition: opacity 0.3s;
		z-index: 10;
	}

	.tooltip::after {
		content: "";
		position: absolute;
		bottom: 100%;
		left: 50%;
		margin-left: -5px;
		border-width: 5px;
		border-style: solid;
		border-color: transparent transparent rgba(0, 0, 0, 0.8) transparent;
	}

	.tooltip-container:hover .tooltip,
	.tooltip-container a:hover .tooltip,
	.tooltip-container div:hover .tooltip {
		visibility: visible;
		opacity: 1;
	}
</style>
