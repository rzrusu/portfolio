---
import "../styles/global.css";
import "@fontsource-variable/instrument-sans";
import "@fontsource/geist-sans/400.css";
import { getImage } from "astro:assets";
import bg from "../assets/backgrounds/bg.png";
import bg2x from "../assets/backgrounds/bg@2x.png";
import avatar from "../assets/avatar.png";
import { profile } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = profile.title, description = profile.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const [bg1xImg, bg2xImg, avatarImg] = await Promise.all([
  getImage({ src: bg, format: "webp" }),
  getImage({ src: bg2x, format: "webp" }),
  getImage({ src: avatar, format: "png" }),
]);
const bgStyle = `--bg-1x: url(${bg1xImg.src}); --bg-2x: url(${bg2xImg.src});`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name: profile.name,
      url: Astro.site?.href,
      jobTitle: profile.role,
      image: new URL(avatarImg.src, Astro.site).href,
      sameAs: [profile.github, profile.behance, profile.linkedin],
    },
    {
      "@type": "WebSite",
      name: `${profile.name} - Portfolio`,
      url: Astro.site?.href,
      inLanguage: "en-US",
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07090E" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body style={bgStyle}>
    <slot />
  </body>
</html>

<style>
  body {
    background-color: #07090e;
    background-image: var(--bg-1x);
    background-image: image-set(var(--bg-1x) 1x, var(--bg-2x) 2x);
    background-repeat: no-repeat;
    background-position: top center;
    background-attachment: fixed;
    background-size: contain;
    margin: 0;
    overflow-x: hidden;
  }
</style>
